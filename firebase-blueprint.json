{
  "entities": {
    "user": {
      "title": "User",
      "description": "A user of the application",
      "type": "object",
      "properties": {
        "coins": {
          "type": "number",
          "description": "Number of coins/points the user has"
        },
        "email": {
          "type": "string",
          "description": "User's email"
        },
        "displayName": {
          "type": "string",
          "description": "User's display name"
        }
      },
      "required": ["coins"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": {
        "$ref": "#/entities/user"
      },
      "description": "User profiles storing their coin balance"
    }
  }
}
